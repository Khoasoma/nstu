include("@CMAKE_BINARY_DIR@/CPackConfig.cmake")
set(CPACK_COMPONENTS_ALL "client;docs")
set(CPACK_INSTALL_CMAKE_PROJECTS
    "@CMAKE_BINARY_DIR@;nstu;client;/;@CMAKE_BINARY_DIR@;nstu;docs;/")
set(CPACK_PACKAGE_FILE_NAME "nstu-client-@PROJECT_VERSION@")
set(CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS [=[
  IfFileExists "$INSTDIR\server\nstu-server.exe" 0 nstu_client_preinstall_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU Client cannot be installed while an NSTU Server is present. Uninstall the server first."
  Abort
nstu_client_preinstall_ok:
]=])
set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS [=[
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\test-install-role.ps1" -Role Client -InstallRoot "$INSTDIR"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_client_role_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU Client cannot be installed alongside an NSTU Server.$\r$\n$\r$\n$1"
  Abort
nstu_client_role_ok:
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\client\install-client-service.ps1" -InstallRoot "$INSTDIR\client"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_install_service_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU could not register the client service.$\r$\n$\r$\n$1"
  Abort
nstu_install_service_ok:
  MessageBox MB_ICONEXCLAMATION|MB_OK "NSTU Client installation completed. Restart Windows before using the client."
  SetRebootFlag true
]=])
set(CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS [=[
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\client\uninstall-client-service.ps1"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_uninstall_service_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU could not prepare the client for removal.$\r$\n$\r$\n$1"
  Abort
nstu_uninstall_service_ok:
  MessageBox MB_ICONEXCLAMATION|MB_OK "NSTU Client removal is staged. Restart Windows to finalize it before installing another NSTU role."
  SetRebootFlag true
]=])
