Unicode true
RequestExecutionLevel admin
Name "@NSTU_INSTALLER_DISPLAY_NAME@"
OutFile "@NSTU_UNIFIED_INSTALLER@"
InstallDir "$PROGRAMFILES64\\NSTU"
InstallDirRegKey HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\NSTU" "InstallLocation"
ShowInstDetails show
ShowUninstDetails show

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "nsDialogs.nsh"
!include "WinMessages.nsh"
!include "FileFunc.nsh"

Var Role
Var RolePage
Var RoleClient
Var RoleServer
Var UwfCheckbox
Var UwfNotice
Var EnableUwf
Var PreflightReport
Var RoomName
Var RoomLabel
Var RoomField
Var IsUpdate
Var DataRoot
Var RoomSpecified
Var UwfSpecified

!define STAGE "@NSTU_UNIFIED_STAGE_DIR@"
!define INTERNAL_TEST_BUILD @NSTU_INTERNAL_TEST_BUILD_VALUE@
!define DEV_UNPROTECTED_BUILD @NSTU_DEV_UNPROTECTED_EXAM_VALUE@

!insertmacro MUI_PAGE_WELCOME
Page custom RolePageCreate RolePageLeave
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  SetRegView 64
  StrCpy $Role "Client"
  StrCpy $EnableUwf "0"
  StrCpy $RoomName ""
  StrCpy $IsUpdate "0"
  StrCpy $RoomSpecified "0"
  StrCpy $UwfSpecified "0"
  StrCpy $PreflightReport "$TEMP\\NSTU-installer-preflight.json"
  ReadRegStr $0 HKLM "Software\\NSTU" "InstallRole"
  StrCmp $0 "" nstu_init_fresh
  StrCpy $IsUpdate "1"
  ReadRegStr $RoomName HKLM "Software\\NSTU" "PreferredRoom"
  ReadRegDWORD $EnableUwf HKLM "Software\\NSTU" "UwfConfigureRequested"
  StrCmp $EnableUwf "1" 0 nstu_init_existing_uwf_done
  StrCpy $EnableUwf ${BST_CHECKED}
nstu_init_existing_uwf_done:
nstu_init_fresh:
  ${GetParameters} $0
  ${GetOptions} $0 "/ROLE=" $1
  ${IfNot} ${Errors}
    StrCpy $Role $1
  ${EndIf}
  ${GetOptions} $0 "/ROOM=" $1
  ${IfNot} ${Errors}
    StrCpy $RoomName $1
    StrCpy $RoomSpecified "1"
  ${EndIf}
  ${GetOptions} $0 "/UWF=" $1
  ${IfNot} ${Errors}
    StrCpy $UwfSpecified "1"
    StrCmp $1 "1" 0 nstu_init_uwf_done
    StrCpy $EnableUwf ${BST_CHECKED}
nstu_init_uwf_done:
  ${EndIf}
FunctionEnd

Function RoleServerClicked
  StrCpy $Role "Server"
  ShowWindow $UwfCheckbox ${SW_HIDE}
  ShowWindow $UwfNotice ${SW_HIDE}
  ShowWindow $RoomLabel ${SW_HIDE}
  ShowWindow $RoomField ${SW_HIDE}
FunctionEnd

Function RoleClientClicked
  StrCpy $Role "Client"
  ShowWindow $UwfCheckbox ${SW_SHOW}
  ShowWindow $UwfNotice ${SW_SHOW}
  ShowWindow $RoomLabel ${SW_SHOW}
  ShowWindow $RoomField ${SW_SHOW}
FunctionEnd

Function RolePageCreate
  nsDialogs::Create 1018
  Pop $RolePage
  ${If} $RolePage == error
    Abort
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 18u "Choose the role for this computer"
  Pop $0
  ${NSD_CreateRadioButton} 0 28u 100% 16u "Install for Client (student computer)"
  Pop $RoleClient
  ${NSD_OnClick} $RoleClient RoleClientClicked
  ${NSD_CreateRadioButton} 0 50u 100% 16u "Install for Server (teacher computer)"
  Pop $RoleServer
  ${NSD_OnClick} $RoleServer RoleServerClicked
  ${NSD_Check} $RoleClient
  ${NSD_CreateLabel} 0 84u 100% 34u "Clients discover NSTU servers on the local network after installation. If several answer, the client asks which one to pair with. The server must approve the matching six-digit code."
  Pop $0
  ${NSD_CreateLabel} 0 120u 100% 11u "Room name (optional - leave blank to choose on screen):"
  Pop $RoomLabel
  ${NSD_CreateText} 0 132u 100% 13u "$RoomName"
  Pop $RoomField
  ${NSD_CreateCheckbox} 0 150u 100% 18u "Enable reboot-to-restore (Education/Enterprise only)"
  Pop $UwfCheckbox
  ${If} $EnableUwf == ${BST_CHECKED}
    ${NSD_Check} $UwfCheckbox
  ${EndIf}
  ${NSD_CreateLabel} 18u 170u 95% 34u "Requires passing readiness checks, persistent NSTU exclusions, and a recovery checkpoint you have verified. UWF is armed only after enrollment."
  Pop $UwfNotice
  ${NSD_CreateLabel} 0 208u 100% 34u "Client preflight checks this computer. A Windows restart activates the service; pairing then happens through the client and server interfaces."
  Pop $0
!if ${INTERNAL_TEST_BUILD}
  ${NSD_CreateLabel} 0 246u 100% 30u "INTERNAL VM TEST: RAM capacity failures are warnings. CPU details are informational in every build. Do not deploy this build to a school or production machine."
  Pop $0
!endif
!if ${DEV_UNPROTECTED_BUILD}
  ${NSD_CreateLabel} 0 246u 100% 40u "DEV (UNPROTECTED) BUILD: This build starts Exam mode WITHOUT reboot-to-restore (UWF) protection. It is for testing only. Do not deploy it to a real exam or production machine. Authentication, pairing, and package validation are unchanged."
  Pop $0
!endif
  StrCmp $Role "Server" nstu_role_page_server nstu_role_page_client
nstu_role_page_server:
  ${NSD_Check} $RoleServer
  Call RoleServerClicked
  Goto nstu_role_page_done
nstu_role_page_client:
  ${NSD_Check} $RoleClient
  Call RoleClientClicked
nstu_role_page_done:
  nsDialogs::Show
FunctionEnd

Function RolePageLeave
  ${NSD_GetState} $RoleServer $0
  ${If} $0 == ${BST_CHECKED}
    StrCpy $Role "Server"
  ${Else}
    StrCpy $Role "Client"
    ${NSD_GetText} $RoomField $RoomName
    StrCpy $RoomSpecified "1"
    ${NSD_GetState} $UwfCheckbox $EnableUwf
    StrCpy $UwfSpecified "1"
    ${If} $EnableUwf == ${BST_CHECKED}
      MessageBox MB_YESNO|MB_ICONEXCLAMATION "Confirm that you created or verified a recovery checkpoint. If readiness passes, this computer will show a 60-second countdown and restart automatically. Continue with reboot-to-restore enabled?" IDYES nstu_uwf_confirmed IDNO nstu_uwf_not_confirmed
nstu_uwf_not_confirmed:
      Abort
nstu_uwf_confirmed:
    ${EndIf}
  ${EndIf}
FunctionEnd

Function ValidateDataRoot
  ReadRegStr $DataRoot HKLM "Software\\NSTU" "DataRoot"
  StrCmp $DataRoot "" 0 nstu_data_root_known
  ReadEnvStr $DataRoot "ProgramData"
  StrCpy $DataRoot "$DataRoot\\NSTU"
nstu_data_root_known:
  System::Call 'kernel32::GetFullPathNameW(w "$DataRoot", i ${NSIS_MAX_STRLEN}, w .r0, p 0) i .r2'
  StrCmp $2 "0" nstu_data_root_invalid
  System::Call 'kernel32::GetFullPathNameW(w "$INSTDIR", i ${NSIS_MAX_STRLEN}, w .r1, p 0) i .r2'
  StrCmp $2 "0" nstu_data_root_invalid
  StrCpy $DataRoot $0
  StrLen $2 $1
  StrCpy $3 $0 $2
  System::Call 'kernel32::lstrcmpiW(w r3, w r1) i .r4'
  StrCmp $4 "0" nstu_data_root_overlap
  StrLen $2 $0
  StrCpy $3 $1 $2
  System::Call 'kernel32::lstrcmpiW(w r3, w r0) i .r4'
  StrCmp $4 "0" nstu_data_root_overlap
  Return
nstu_data_root_invalid:
  MessageBox MB_ICONSTOP|MB_OK "The configured NSTU DataRoot path is invalid. No files were changed."
  Abort
nstu_data_root_overlap:
  MessageBox MB_ICONSTOP|MB_OK "NSTU DataRoot overlaps the program installation directory. Move DataRoot outside $INSTDIR before updating. No files were changed."
  Abort
FunctionEnd

Section -Preflight
  ReadRegStr $0 HKLM "Software\\NSTU" "InstallRole"
  StrCmp $0 "" nstu_no_registered_role
  StrCmp $0 $Role nstu_registered_role_matches
  MessageBox MB_ICONSTOP|MB_OK "A different NSTU role is already registered. Uninstall it and restart Windows before selecting this role."
  Abort
nstu_registered_role_matches:
  StrCpy $IsUpdate "1"
  StrCmp $Role "Client" 0 nstu_registered_server_marker
  IfFileExists "$INSTDIR\\client\\nstu-service.exe" nstu_role_registry_checked
  Goto nstu_ambiguous_install
nstu_registered_server_marker:
  IfFileExists "$INSTDIR\\server\\nstu-server.exe" nstu_role_registry_checked
  Goto nstu_ambiguous_install
nstu_no_registered_role:
  StrCpy $IsUpdate "0"
  IfFileExists "$INSTDIR\\client\\nstu-service.exe" nstu_ambiguous_install
  IfFileExists "$INSTDIR\\server\\nstu-server.exe" nstu_ambiguous_install
  Goto nstu_role_registry_checked
nstu_ambiguous_install:
  MessageBox MB_ICONSTOP|MB_OK "NSTU registry and program files do not describe one complete installation. Repair or remove the old installation before retrying. No files were changed."
  Abort
nstu_role_registry_checked:
  ; A staged uninstall task runs as SYSTEM after restart and targets $INSTDIR\Uninstall.exe.
  ; If left behind, it can execute a newly installed uninstaller and silently remove the fresh
  ; installation. Updates must not race pending removal; fresh installs clear abandoned state.
  nsExec::ExecToStack 'schtasks.exe /Query /TN "NSTU-FinalizeUninstall"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_finalize_task_present nstu_finalize_task_checked
nstu_finalize_task_present:
  StrCmp $IsUpdate "1" nstu_pending_removal
  nsExec::ExecToStack 'schtasks.exe /Delete /TN "NSTU-FinalizeUninstall" /F'
  Pop $0
  Pop $1
  StrCmp $0 "0" 0 nstu_stale_removal_cleanup_failed
nstu_finalize_task_checked:
  StrCmp $IsUpdate "1" nstu_removal_state_checked
  ReadEnvStr $0 "ProgramData"
  Delete "$0\NSTU\uninstall-state.json"
nstu_removal_state_checked:
  IfFileExists "$INSTDIR\\.nstu-backup-client\\*.*" nstu_pending_backup
  IfFileExists "$INSTDIR\\.nstu-backup-server\\*.*" nstu_pending_backup
  IfFileExists "$INSTDIR\\.nstu-backup-diagnostics\\*.*" nstu_pending_backup
  Call ValidateDataRoot
  Goto nstu_preflight_payload
nstu_pending_backup:
  MessageBox MB_ICONSTOP|MB_OK "A previous NSTU update backup is still present. Restart Windows and repair that update before retrying. No files were changed."
  Abort
nstu_pending_removal:
  MessageBox MB_ICONSTOP|MB_OK "NSTU removal is pending after restart. Complete or cancel that removal before updating. No files were changed."
  Abort
nstu_stale_removal_cleanup_failed:
  MessageBox MB_ICONSTOP|MB_OK "A stale NSTU removal task could not be cleared. Remove the NSTU-FinalizeUninstall scheduled task before reinstalling. No files were changed.$\r$\n$\r$\n$1"
  Abort
nstu_preflight_payload:

  SetOutPath "$PLUGINSDIR\\NSTU-Diagnostics"
  File "${STAGE}\\diagnostics\\nstu-diagnostics.exe"
!if @NSTU_MINGW_RUNTIME_FILES_PRESENT@
  File /nonfatal "${STAGE}\\diagnostics\\libgcc_s_seh-1.dll"
  File /nonfatal "${STAGE}\\diagnostics\\libstdc++-6.dll"
  File /nonfatal "${STAGE}\\diagnostics\\libwinpthread-1.dll"
!endif
  StrCmp $Role "Server" nstu_preflight_server
  StrCmp $Role "Client" 0 nstu_preflight_invalid_role
  nsExec::ExecToStack '"$PLUGINSDIR\\NSTU-Diagnostics\\nstu-diagnostics.exe" --target=client --installer --auto-close --report="$PreflightReport"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_preflight_ok
  MessageBox MB_ICONSTOP|MB_OK "Client preflight failed. The diagnostics window contains the failed checks.$\r$\n$\r$\nThe report was saved to:$\r$\n$PreflightReport$\r$\n$\r$\n$1"
  Abort
nstu_preflight_invalid_role:
  MessageBox MB_ICONSTOP|MB_OK "Invalid installer role. Use Client or Server."
  Abort
nstu_preflight_server:
  nsExec::ExecToStack '"$PLUGINSDIR\\NSTU-Diagnostics\\nstu-diagnostics.exe" --target=server --installer --auto-close --report="$PreflightReport"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_preflight_ok
  MessageBox MB_ICONSTOP|MB_OK "Server preflight failed. The diagnostics window contains the failed checks.$\r$\n$\r$\nThe report was saved to:$\r$\n$PreflightReport$\r$\n$\r$\n$1"
  Abort
nstu_preflight_ok:
  Delete "$PreflightReport"
SectionEnd

Section -Server
  StrCmp $Role "Server" 0 nstu_server_done
  RMDir /r "$INSTDIR\.nstu-stage-server"
  RMDir /r "$INSTDIR\.nstu-stage-diagnostics"
  SetOutPath "$INSTDIR\.nstu-stage-server"
  File /r "${STAGE}\server\*"
  SetOutPath "$INSTDIR\.nstu-stage-diagnostics"
  File /r "${STAGE}\diagnostics\*"
  IfFileExists "$INSTDIR\.nstu-stage-server\nstu-server.exe" 0 nstu_server_stage_failed
  IfFileExists "$INSTDIR\.nstu-stage-diagnostics\nstu-diagnostics.exe" 0 nstu_server_stage_failed
  ; Keep the process working directory outside both staging directories before promotion.
  SetOutPath "$INSTDIR"
  StrCmp $IsUpdate "1" 0 nstu_server_promote_fresh
  ClearErrors
  Rename "$INSTDIR\server" "$INSTDIR\.nstu-backup-server"
  IfErrors nstu_server_running
  ClearErrors
  Rename "$INSTDIR\diagnostics" "$INSTDIR\.nstu-backup-diagnostics"
  IfErrors nstu_server_restore_role
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-server" "$INSTDIR\server"
  IfErrors nstu_server_restore_both
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_server_restore_promoted
  Goto nstu_server_commit
nstu_server_promote_fresh:
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-server" "$INSTDIR\server"
  IfErrors nstu_server_stage_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_server_fresh_restore
  Goto nstu_server_commit
nstu_server_commit:
  WriteRegStr HKLM "Software\NSTU" "InstallRole" "Server"
  WriteRegStr HKLM "Software\NSTU" "BuildChannel" "@NSTU_INSTALLER_CHANNEL@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\NSTU" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\NSTU" "DisplayName" "NSTU Server@NSTU_INSTALLER_ROLE_SUFFIX@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "NSTU Server" '"$INSTDIR\server\nstu-server.exe"'
  ; Start Menu shortcut so the teacher can find and launch NSTU Server from
  ; Windows Search / the Start menu. SetOutPath fixes the shortcut's working
  ; directory to the server folder so the bundled MinGW runtime DLLs resolve.
  SetOutPath "$INSTDIR\server"
  CreateDirectory "$SMPROGRAMS\NSTU"
  CreateShortCut "$SMPROGRAMS\NSTU\NSTU Server@NSTU_INSTALLER_ROLE_SUFFIX@.lnk" "$INSTDIR\server\nstu-server.exe" "" "$INSTDIR\server\nstu-server.exe" 0
  SetOutPath "$INSTDIR"
  ; Configure least-privilege Windows Firewall rules for NSTU Server control plane (TCP 47001)
  ; and UDP discovery (UDP 47001) scoped strictly to the server executable and private/domain profiles.
  nsExec::ExecToStack 'netsh.exe advfirewall firewall add rule name="NSTU Server (TCP-In)" dir=in action=allow program="$INSTDIR\server\nstu-server.exe" protocol=TCP localport=47001 profile=private,domain enable=yes'
  Pop $0
  Pop $1
  nsExec::ExecToStack 'netsh.exe advfirewall firewall add rule name="NSTU Server Discovery (UDP-In)" dir=in action=allow program="$INSTDIR\server\nstu-server.exe" protocol=UDP localport=47001 profile=private,domain enable=yes'
  Pop $0
  Pop $1
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  RMDir /r "$INSTDIR\.nstu-backup-server"
  RMDir /r "$INSTDIR\.nstu-backup-diagnostics"
  Goto nstu_server_done
nstu_server_running:
  MessageBox MB_ICONSTOP|MB_OK "Close NSTU Server, then retry the update. Existing files and configuration were not changed."
  Goto nstu_server_abort
nstu_server_restore_role:
  Rename "$INSTDIR\.nstu-backup-server" "$INSTDIR\server"
  Goto nstu_server_rollback_failed
nstu_server_restore_both:
  Rename "$INSTDIR\.nstu-backup-diagnostics" "$INSTDIR\diagnostics"
  Rename "$INSTDIR\.nstu-backup-server" "$INSTDIR\server"
  Goto nstu_server_rollback_failed
nstu_server_restore_promoted:
  Rename "$INSTDIR\server" "$INSTDIR\.nstu-stage-server"
  Rename "$INSTDIR\.nstu-backup-diagnostics" "$INSTDIR\diagnostics"
  Rename "$INSTDIR\.nstu-backup-server" "$INSTDIR\server"
  Goto nstu_server_rollback_failed
nstu_server_fresh_restore:
  Rename "$INSTDIR\server" "$INSTDIR\.nstu-stage-server"
nstu_server_stage_failed:
  MessageBox MB_ICONSTOP|MB_OK "NSTU Server update payload is incomplete. Existing configuration was preserved."
  Goto nstu_server_abort
nstu_server_rollback_failed:
  MessageBox MB_ICONSTOP|MB_OK "NSTU Server update failed and rollback was attempted. Restart Windows before retrying; keep any .nstu-backup directories for repair."
nstu_server_abort:
  nsExec::ExecToStack 'netsh.exe advfirewall firewall delete rule name="NSTU Server (TCP-In)"'
  Pop $0
  Pop $1
  nsExec::ExecToStack 'netsh.exe advfirewall firewall delete rule name="NSTU Server Discovery (UDP-In)"'
  Pop $0
  Pop $1
  RMDir /r "$INSTDIR\.nstu-stage-server"
  RMDir /r "$INSTDIR\.nstu-stage-diagnostics"
  Abort
nstu_server_done:
SectionEnd

Section -Client
  StrCmp $Role "Client" 0 nstu_client_done
  ReadEnvStr $R0 "ProgramData"
  RMDir /r "$INSTDIR\.nstu-stage-client"
  RMDir /r "$INSTDIR\.nstu-stage-diagnostics"
  SetOutPath "$INSTDIR\.nstu-stage-client"
  File /r "${STAGE}\client\*"
  SetOutPath "$INSTDIR\.nstu-stage-diagnostics"
  File /r "${STAGE}\diagnostics\*"
  IfFileExists "$INSTDIR\.nstu-stage-client\nstu-service.exe" 0 nstu_client_stage_failed
  IfFileExists "$INSTDIR\.nstu-stage-client\nstu-agent.exe" 0 nstu_client_stage_failed
  IfFileExists "$INSTDIR\.nstu-stage-diagnostics\nstu-diagnostics.exe" 0 nstu_client_stage_failed
  ; Keep the process working directory outside both staging directories before promotion.
  SetOutPath "$INSTDIR"
  StrCmp $IsUpdate "1" 0 nstu_client_promote_fresh
  nsExec::ExecToStack '"$INSTDIR\.nstu-stage-client\nstu-service.exe" --prepare-update'
  Pop $0
  Pop $1
  StrCmp $0 "0" 0 nstu_client_prepare_failed
  ClearErrors
  Rename "$INSTDIR\client" "$INSTDIR\.nstu-backup-client"
  IfErrors nstu_client_swap_failed
  ClearErrors
  Rename "$INSTDIR\diagnostics" "$INSTDIR\.nstu-backup-diagnostics"
  IfErrors nstu_client_restore_role
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-client" "$INSTDIR\client"
  IfErrors nstu_client_restore_both
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_client_restore_promoted
  Goto nstu_client_install_service
nstu_client_promote_fresh:
  ; RMDir on absent stale-stage paths can leave NSIS's global error flag set. Clear it before
  ; each operation whose result is tested, or a successful Rename is mistaken for failure.
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-client" "$INSTDIR\client"
  IfErrors nstu_client_stage_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-stage-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_client_fresh_restore
nstu_client_install_service:
  nsExec::ExecToStack '"$INSTDIR\client\nstu-service.exe" --install'
  Pop $0
  Pop $1
  StrCmp $0 "0" 0 nstu_client_setup_failed
  WriteRegStr HKLM "Software\NSTU" "InstallRole" "Client"
  WriteRegStr HKLM "Software\NSTU" "BuildChannel" "@NSTU_INSTALLER_CHANNEL@"
  StrCmp $UwfSpecified "1" 0 nstu_client_keep_uwf
  ${If} $EnableUwf == ${BST_CHECKED}
    WriteRegDWORD HKLM "Software\NSTU" "UwfConfigureRequested" 1
  ${Else}
    WriteRegDWORD HKLM "Software\NSTU" "UwfConfigureRequested" 0
  ${EndIf}
nstu_client_keep_uwf:
  StrCmp $RoomSpecified "1" 0 nstu_client_keep_room
  ${If} $RoomName != ""
    WriteRegStr HKLM "Software\NSTU" "PreferredRoom" "$RoomName"
  ${Else}
    DeleteRegValue HKLM "Software\NSTU" "PreferredRoom"
  ${EndIf}
nstu_client_keep_room:
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\NSTU" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\NSTU" "DisplayName" "NSTU Client@NSTU_INSTALLER_ROLE_SUFFIX@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "NSTU Diagnostics" '"$INSTDIR\diagnostics\nstu-diagnostics.exe" --target=client --boot-check --auto-close --log="$R0\NSTU\boot-check.log"'
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  RMDir /r "$INSTDIR\.nstu-backup-client"
  RMDir /r "$INSTDIR\.nstu-backup-diagnostics"
  SetRebootFlag true
  Goto nstu_client_done
nstu_client_setup_failed:
  StrCmp $IsUpdate "1" 0 nstu_client_fresh_setup_failed
  RMDir /r "$INSTDIR\client"
  IfFileExists "$INSTDIR\client\*.*" nstu_client_setup_rollback_failed
  RMDir /r "$INSTDIR\diagnostics"
  IfFileExists "$INSTDIR\diagnostics\*.*" nstu_client_setup_rollback_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-client" "$INSTDIR\client"
  IfErrors nstu_client_setup_rollback_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_client_setup_rollback_failed
  nsExec::ExecToStack '"$INSTDIR\client\nstu-service.exe" --install'
  Pop $2
  Pop $3
  StrCmp $2 "0" 0 nstu_client_setup_rollback_failed
  MessageBox MB_ICONSTOP|MB_OK "Client service setup failed. The previous payload and service configuration were restored; registry and DataRoot were preserved.$\r$\n$\r$\n$1$\r$\n$\r$\nRestart Windows before retrying."
  Abort
nstu_client_setup_rollback_failed:
  MessageBox MB_ICONSTOP|MB_OK "Client service setup failed and rollback could not be completed safely. Registry and DataRoot were preserved. Restart Windows and repair from the .nstu-backup directories before retrying.$\r$\n$\r$\n$1"
  Abort
nstu_client_fresh_setup_failed:
  RMDir /r "$INSTDIR\client"
  RMDir /r "$INSTDIR\diagnostics"
  MessageBox MB_ICONSTOP|MB_OK "Client service setup failed. NSTU configuration and DataRoot were not deleted.$\r$\n$\r$\n$1"
  Abort
nstu_client_prepare_failed:
  MessageBox MB_ICONSTOP|MB_OK "The existing client service could not be prepared for update. Program files and configuration were not changed.$\r$\n$\r$\n$1"
  Goto nstu_client_abort
nstu_client_swap_failed:
  nsExec::ExecToStack '"$INSTDIR\client\nstu-service.exe" --install'
  Pop $2
  Pop $3
  StrCmp $2 "0" 0 nstu_client_swap_repair_failed
  MessageBox MB_ICONSTOP|MB_OK "Existing NSTU Client files are locked. Service configuration was restored; restart Windows and retry."
  Goto nstu_client_abort
nstu_client_swap_repair_failed:
  MessageBox MB_ICONSTOP|MB_OK "Existing NSTU Client files are locked and service repair failed.$\r$\n$\r$\n$3$\r$\n$\r$\nRestart Windows before retrying."
  Goto nstu_client_abort
nstu_client_restore_role:
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-client" "$INSTDIR\client"
  IfErrors nstu_client_rollback_failed
  Goto nstu_client_repair_old_service
nstu_client_restore_both:
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_client_rollback_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-client" "$INSTDIR\client"
  IfErrors nstu_client_rollback_failed
  Goto nstu_client_repair_old_service
nstu_client_restore_promoted:
  ClearErrors
  Rename "$INSTDIR\client" "$INSTDIR\.nstu-stage-client"
  IfErrors nstu_client_rollback_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-diagnostics" "$INSTDIR\diagnostics"
  IfErrors nstu_client_rollback_failed
  ClearErrors
  Rename "$INSTDIR\.nstu-backup-client" "$INSTDIR\client"
  IfErrors nstu_client_rollback_failed
nstu_client_repair_old_service:
  nsExec::ExecToStack '"$INSTDIR\client\nstu-service.exe" --install'
  Pop $2
  Pop $3
  StrCmp $2 "0" nstu_client_rollback_restored
  MessageBox MB_ICONSTOP|MB_OK "The old NSTU payload was restored, but its service configuration could not be repaired.$\r$\n$\r$\n$3$\r$\n$\r$\nRestart Windows before retrying."
  Goto nstu_client_abort
nstu_client_rollback_restored:
  MessageBox MB_ICONSTOP|MB_OK "The NSTU Client update failed. The previous payload and service configuration were restored; registry and DataRoot were preserved. Restart Windows before retrying."
  Goto nstu_client_abort
nstu_client_fresh_restore:
  ClearErrors
  Rename "$INSTDIR\client" "$INSTDIR\.nstu-stage-client"
nstu_client_stage_failed:
  MessageBox MB_ICONSTOP|MB_OK "NSTU Client update payload is incomplete. Existing configuration was preserved."
  Goto nstu_client_abort
nstu_client_rollback_failed:
  MessageBox MB_ICONSTOP|MB_OK "NSTU Client update failed. Previous payload restoration was attempted; restart Windows before retrying. Keep any .nstu-backup directories for repair."
nstu_client_abort:
  RMDir /r "$INSTDIR\.nstu-stage-client"
  RMDir /r "$INSTDIR\.nstu-stage-diagnostics"
  Abort
nstu_client_done:
SectionEnd

Section -Finish
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\NSTU" "Publisher" "Project NSTU"
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\NSTU" "UninstallString" '"$INSTDIR\\Uninstall.exe"'
  StrCmp $Role "Client" 0 nstu_finish_done
  IfSilent nstu_finish_reboot
  MessageBox MB_OK|MB_ICONINFORMATION "Client installation is complete. Windows must restart now to activate NSTU."
nstu_finish_reboot:
  Reboot
nstu_finish_done:
SectionEnd

Function un.onInit
  SetRegView 64
  ReadRegStr $Role HKLM "Software\\NSTU" "InstallRole"
  StrCmp $Role "Client" 0 nstu_uninit_not_client
  StrCpy $0 "0"
  ReadRegDWORD $0 HKLM "Software\\NSTU" "Frozen"
  IntCmp $0 0 nstu_uninit_not_client nstu_uninit_frozen nstu_uninit_frozen
nstu_uninit_frozen:
  MessageBox MB_ICONSTOP|MB_OK "This NSTU client is in Managed mode. Disable Managed mode from the server, or run nstu-service.exe --thaw-local from an elevated command prompt, before uninstalling."
  Abort
nstu_uninit_not_client:
FunctionEnd

Section "Uninstall"
  ReadRegStr $Role HKLM "Software\NSTU" "InstallRole"
  StrCmp $Role "Client" 0 nstu_uninstall_server
  IfFileExists "$INSTDIR\client\nstu-service.exe" 0 nstu_uninstall_files
  nsExec::ExecToStack '"$INSTDIR\client\nstu-service.exe" --uninstall'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_uninstall_client_processes
  MessageBox MB_ICONSTOP|MB_OK "NSTU client service removal failed.$\r$\n$\r$\n$1"
  Abort
nstu_uninstall_client_processes:
  Goto nstu_uninstall_files
nstu_uninstall_server:
  nsExec::ExecToStack 'netsh.exe advfirewall firewall delete rule name="NSTU Server (TCP-In)"'
  Pop $0
  Pop $1
  nsExec::ExecToStack 'netsh.exe advfirewall firewall delete rule name="NSTU Server Discovery (UDP-In)"'
  Pop $0
  Pop $1
nstu_uninstall_files:
  ; Cancel any staged-removal task before deleting this uninstaller. Otherwise a later fresh
  ; install at the same path can be removed by the stale SYSTEM task after restart.
  nsExec::ExecToStack 'schtasks.exe /Delete /TN "NSTU-FinalizeUninstall" /F'
  Pop $0
  Pop $1
  ReadEnvStr $0 "ProgramData"
  Delete "$0\NSTU\uninstall-state.json"
  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "NSTU Diagnostics"
  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "NSTU Server"
  ; Remove the Start Menu shortcut created for the server role (harmless for the
  ; client role, where it was never created).
  Delete "$SMPROGRAMS\NSTU\NSTU Server@NSTU_INSTALLER_ROLE_SUFFIX@.lnk"
  RMDir "$SMPROGRAMS\NSTU"
  DeleteRegKey HKLM "Software\NSTU"
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\NSTU"
  RMDir /r /REBOOTOK "$INSTDIR\client"
  RMDir /r /REBOOTOK "$INSTDIR\server"
  RMDir /r /REBOOTOK "$INSTDIR\diagnostics"
  Delete /REBOOTOK "$INSTDIR\Uninstall.exe"
  RMDir /REBOOTOK "$INSTDIR"
SectionEnd
