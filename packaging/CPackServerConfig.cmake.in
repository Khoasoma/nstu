include("@CMAKE_BINARY_DIR@/CPackConfig.cmake")
set(CPACK_COMPONENTS_ALL "server;docs")
set(CPACK_INSTALL_CMAKE_PROJECTS
    "@CMAKE_BINARY_DIR@;nstu;server;/;@CMAKE_BINARY_DIR@;nstu;docs;/")
set(CPACK_PACKAGE_FILE_NAME "nstu-server-@PROJECT_VERSION@")
set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS [=[
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\configure-data-root.ps1" -DataRoot "$COMMONAPPDATA\NSTU"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_server_data_root_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU could not configure its protected data directory.$\r$\n$\r$\n$1"
  Abort
nstu_server_data_root_ok:
]=])
