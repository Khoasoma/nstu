include("@CMAKE_BINARY_DIR@/CPackConfig.cmake")
set(CPACK_COMPONENTS_ALL "server;docs")
set(CPACK_INSTALL_CMAKE_PROJECTS
    "@CMAKE_BINARY_DIR@;nstu;server;/;@CMAKE_BINARY_DIR@;nstu;docs;/")
set(CPACK_PACKAGE_FILE_NAME "nstu-server-@PROJECT_VERSION@")
set(CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS [=[
  IfFileExists "$INSTDIR\client\nstu-service.exe" 0 nstu_server_preinstall_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU Server cannot be installed while an NSTU Client is present. Uninstall the client and restart Windows first."
  Abort
nstu_server_preinstall_ok:
  IfFileExists "$INSTDIR\client\nstu-agent.exe" 0 nstu_server_preinstall_done
  MessageBox MB_ICONSTOP|MB_OK "NSTU Server cannot be installed while an NSTU Client is present. Uninstall the client and restart Windows first."
  Abort
nstu_server_preinstall_done:
]=])
set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS [=[
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\test-install-role.ps1" -Role Server -InstallRoot "$INSTDIR"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_server_role_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU Server cannot be installed alongside an NSTU Client.$\r$\n$\r$\n$1"
  Abort
nstu_server_role_ok:
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\test-system-setup.ps1" -Role Server -DataRoot "$COMMONAPPDATA\NSTU" -ExpectedServerBinary "$INSTDIR\server\nstu-server.exe"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_server_setup_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU system setup validation failed.$\r$\n$\r$\n$1"
  Abort
nstu_server_setup_ok:
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\configure-data-root.ps1" -DataRoot "$COMMONAPPDATA\NSTU"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_server_data_root_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU could not configure its protected data directory.$\r$\n$\r$\n$1"
  Abort
nstu_server_data_root_ok:
]=])
set(CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS [=[
  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$INSTDIR\docs\deployment\uninstall-server.ps1"'
  Pop $0
  Pop $1
  StrCmp $0 "0" nstu_uninstall_server_ok
  MessageBox MB_ICONSTOP|MB_OK "NSTU could not stop the server cleanly.$\r$\n$\r$\n$1"
  Abort
nstu_uninstall_server_ok:
  MessageBox MB_ICONEXCLAMATION|MB_OK "NSTU Server removal is staged. Restart Windows to finalize it before installing another NSTU role."
  SetRebootFlag true
]=])
